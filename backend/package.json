{
  "name": "madrasapulse-backend",
  "version": "1.0.0",
  "description": "Backend API services for MadrasaPulse",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "test": "jest --runInBand --detectOpenHandles --forceExit",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "prepare": "husky",
    "test:coverage": "jest --runInBand --detectOpenHandles --forceExit --coverage",
    "seed": "node src/seed.js",
    "migrate": "node ../scripts/migrate.js",
    "migrate:create": "node -e \"const fs=require('fs'),p=require('path');const n=process.argv[1];if(!n){console.error('Usage: npm run migrate:create <name>');process.exit(1);}const d=p.join(__dirname,'..','scripts','migrations');fs.mkdirSync(d,{recursive:true});const f=p.join(d,n+'.js');if(fs.existsSync(f)){console.error('Migration already exists:',f);process.exit(1);}fs.writeFileSync(f,'module.exports={name:\"'+n+'\",up:async(db)=>{console.log(\"Migration '+n+' running.\");}};\\n');console.log('Created migration:',f);\" --"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.4.1",
    "zod": "^3.23.8",
    "express-rate-limit": "^7.4.0",
    "@sentry/node": "^8.0.0",
    "@sentry/profiling-node": "^8.0.0",
    "helmet": "^7.1.0",
    "winston": "^3.13.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "jest": "^30.4.2",
    "nodemon": "^3.1.3",
    "supertest": "^7.2.2",
    "eslint": "^8.57.0",
    "prettier": "^3.3.0",
    "husky": "^9.0.0",
    "lint-staged": "^15.2.0"
  }
}
